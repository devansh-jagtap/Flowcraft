PORT=5000
# Postgres (Neon). `neon deploy` writes both to .env.local in the repo root, which the API also reads.
# Pooled URL for the app, direct (unpooled) URL for running migrations at startup.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Clerk (https://dashboard.clerk.com → API keys). Verifies the session tokens the client sends.
CLERK_SECRET_KEY=sk_test_xxx
# Optional: PEM public key to verify tokens without a network call
CLERK_JWT_KEY=
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# AI diagram generation. Vercel AI Gateway is used when its key is set (https://vercel.com/ai-gateway)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-2.5-flash
# Fallback: Google Gemini directly. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free generations on the key above, per window: AI_FREE_LIMIT per signed-in account, AI_FREE_GUEST_LIMIT
# per guest network address. After that people add their own Gemini / OpenAI / AI Gateway key. 0 = none.
AI_FREE_LIMIT=5
AI_FREE_GUEST_LIMIT=2
AI_FREE_WINDOW_HOURS=24
# Encrypts the API keys users save to their account (AES-256-GCM). 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it secret and never change it once users have saved keys, or those keys become unreadable.
AI_KEYS_SECRET=
# Default model for visitors who bring their own OpenAI key
OPENAI_MODEL=gpt-4.1-mini
# Number of proxies in front of the app (1 on Render, Railway, Fly, Heroku...). Defaults to 1 in production.
# TRUST_PROXY=1
