PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/flowcraft
# Clerk (https://dashboard.clerk.com → API keys). Verifies the session tokens the client sends.
CLERK_SECRET_KEY=sk_test_xxx
# Optional: PEM public key to verify tokens without a network call
CLERK_JWT_KEY=
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# AI diagram generation (Google Gemini). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
